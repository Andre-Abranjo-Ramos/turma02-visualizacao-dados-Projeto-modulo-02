# =====================================================================
# MODELO de credenciais (este arquivo PODE ir para o GitHub).
#
# Como usar:
#   1. Copie este arquivo e renomeie a cópia para: secrets.toml
#   2. Preencha com os dados do seu projeto Supabase
#      (Supabase > Connect > Session pooler)
#   3. O secrets.toml real está no .gitignore e NUNCA vai para o GitHub.
#   4. No Streamlit Cloud, cole este mesmo conteúdo em: App > Settings > Secrets
# =====================================================================

[connections.postgresql]
dialect  = "postgresql"
host     = "aws-0-sa-east-1.pooler.supabase.com"   # copie o host exato do painel
port     = "5432"                                  # porta do Session pooler
database = "postgres"
username = "postgres.SEU_PROJECT_REF"              # formato do usuário no pooler
password = "SUA_SENHA_AQUI"
